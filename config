#file containing parameter for genome assembly:
#INPUT CONFIGURATION ----------------------------------------------------------------------
datatype="nano-hq" #either: 'nano-hq', 'nano-raw', 'hifi'
#HiFi ONLY: 
BAM=""             #RAW HiFi only : the bam file
#HiFi optional:
FASTQ=""           #optional: full path to a fastq.gz in case of already basecall nano or hifi

#--------------------------------------------------------------------------------------------
#ONT ONLY:
pod5="pod5/"       #RAW nano only: folder containing the raw 'pod5'
MODEL="dna_r10.4.1_e8.2_400bps_sup@v5.2.0"  #a model for basecalling: ex: dna_r10.4.1_e8.2_400bps_sup@v4.3.0 
                                            #models are available at:https://software-docs.nanoporetech.com/dorado/latest/models/list/
SPECIES=""         #an id/name for the species/strain/etc : eg. fungi001

#OPTIONAL ONT
FASTQ=""           #path of fastq.gz if basecalling already done
CORRECT="YES"      #string YES/NO to specify if herro correction of ONT read should be performed


#-------------------------------------------------------------------------------------------
assembler="flye"   #either: flye, hifiasm, canu


#OTHER PARAMETERS --------------------------------------------------------------------------
genomesize="30000000"      #integer: size of the genome in base pair
ploidy="1"                 #integer: '1' for haploid, '2' for diploid
buscodatabase="microbotryomycetes_odb12.2"     #busco database to chose can be obtained through busco --list-dataset eg: basidiomycota
buscotype="miniprot" #Type for Busco : augustus meteuk miniprot


#OPTIONAL QUALITY FILTERING ----------------------------------------------------------------
remove_lowQualContigs="YES" #sting YES/NO to specify if contig whose proportion of read with 
                            #MAPQ = 0 should be removed if they exceed a given threshold 
                            #
threshold=0.9               #remove contig whose at least $threshold of supporting reads have MAPQ = 0 
                            #according to minimap2 mapping


#OPTIONAL FOR FSC-GX ONLY:
taxid=""
gxdb="" 
