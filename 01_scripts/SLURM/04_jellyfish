#!/bin/bash - 
#SBATCH --account=youraccount
#SBATCH --time=06:00:00
#SBATCH --job-name=jellyfish
#SBATCH --output=log_jelly-%J.out
#SBATCH --mem=30G
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=1

# Move to directory where job was submitted
cd $SLURM_SUBMIT_DIR
#===============================================================================
set -o nounset                              # Treat unset variables as an error
#===============================================================================

source config #a filer with genomesize, data type, fastq/pod5, basename etc ploidy
input=$1  #the input as a fastq.gz #could be set in config as well ?

echo "ploidy is $ploidy"
echo "data type is $datatype" 
echo " "

kmer_length=21

chmod +x ./01_scripts/04_jellyfish
if ! ./01_scripts/04_jellyfish "${input}" "${ploidy}" "${kmer_length}"  "${datatype}" ; then
    echo "error Jellyfish failed"
    exit 1
else
    echo -e "jellfyish successfully run\n"
fi


